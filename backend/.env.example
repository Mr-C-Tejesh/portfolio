# Backend configuration template — copy to .env and fill in real values.
# Never commit the actual .env file; it is gitignored.

# Comma-separated list of allowed frontend origins for CORS.
# Production: add the exact deployed frontend URL (e.g. https://your-portfolio.vercel.app)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API key (required for Ask Tejesh to work).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (defaults to gemini-2.5-flash if unset).
GEMINI_MODEL=gemini-2.5-flash

# Rate limiting cooldown in seconds. Must be a finite positive number.
CHAT_RATE_LIMIT_SECONDS=5.0

# ---------------------------------------------------------------------------
# Contact Form / Email Delivery (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
CONTACT_TO_EMAIL=tejeshc17@gmail.com
# Must be a verified sender domain in Resend.
# For example: contact@yourdomain.com.
# The default 'onboarding@resend.dev' is only permitted during local testing
# if allowed by Resend and can only send to your own registered email address.
# Production requires a verified sender domain on the Resend dashboard.
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_RATE_LIMIT_SECONDS=60.0

# ---------------------------------------------------------------------------
# Frontend build-time variable (set in hosting provider, not in this file)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://your-backend.railway.app
# Required for production deploys. Without it, the Ask Tejesh page will show
# a configuration error instead of silently calling the visitor's localhost.
